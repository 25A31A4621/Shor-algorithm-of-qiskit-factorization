import numpy as np
from qiskit import QuantumCircuit, transpile
from qiskit_aer import Aer
from qiskit.visualization import plot_histogram
import matplotlib.pyplot as plt
from math import gcd
from fractions import Fraction

N = 15
a = 2
if gcd(a, N) != 1:
    print("Factor Found Classically:", gcd(a, N))
else:
    n_count = 4
    qc = QuantumCircuit(n_count + 4, n_count)
    for q in range(n_count):
        qc.h(q)
    qc.x(n_count + 3)
    for q in range(n_count):
        qc.cx(q, n_count + (q % 4))

    def inverse_qft(circuit, n):
        for qubit in range(n // 2):
            circuit.swap(qubit, n - qubit - 1)
        for j in range(n):
            for m in range(j):
                circuit.cp(-np.pi / float(2 ** (j - m)), m, j)
            circuit.h(j)

    inverse_qft(qc, n_count)
    qc.measure(range(n_count), range(n_count))

    print("Shor Circuit:")
    print(qc.draw())

    simulator = Aer.get_backend('aer_simulator')
    compiled = transpile(qc, simulator)
    job = simulator.run(compiled, shots=1000)
    result = job.result()
    counts = result.get_counts()
    print("\nMeasurement results:", counts)
    plot_histogram(counts)
    plt.show()

    measured_value = max(counts, key=counts.get)
    decimal = int(measured_value, 2)
    print("\nMost Frequent Measurement (decimal):", decimal)
    frac = Fraction(decimal / (2 ** n_count)).limit_denominator(N)
    r = frac.denominator
    print("Estimated Period R =", r)

    if r % 2 != 0:
        print("r is odd, retry with different a")
    else:
        factor1 = gcd(a ** (r // 2) - 1, N)
        factor2 = gcd(a ** (r // 2) + 1, N)
        print("\nFactors found:", factor1, factor2)
